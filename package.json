{
  "name": "@ty000/paperclip-linear-intake",
  "version": "0.2.0",
  "private": true,
  "description": "Disabled-by-default Linear Todo request retention and source retrieval for Paperclip",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build-manifest.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:postgres": "npm run build && node --test --test-concurrency=1 test/postgres/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "audit:static": "FALLOW_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 fallow audit --format json --quiet --no-cache --no-type-aware --gate new-only"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1005.0"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.1005.0",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fallow": "3.23.0",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
