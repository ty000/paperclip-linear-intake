{
  "name": "@ty000/paperclip-linear-intake",
  "version": "0.6.3",
  "description": "Disabled-by-default Linear Todo retention and native family preparation for Paperclip",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ty000/paperclip-linear-intake.git"
  },
  "homepage": "https://github.com/ty000/paperclip-linear-intake#readme",
  "bugs": {
    "url": "https://github.com/ty000/paperclip-linear-intake/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/build-manifest.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:postgres": "npm run build && node --test --test-concurrency=1 test/postgres/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "audit:static": "FALLOW_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 fallow audit --format json --quiet --no-cache --no-type-aware --gate new-only"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1005.0"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.1005.0",
    "@types/node": "24.19.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fallow": "3.23.0",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
